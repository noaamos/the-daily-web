<%- include('../partials/head', { styles: ['/css/public.css'] }) %>
<%- include('../partials/header', { navActive: initial.category }) %>
<%
  // Full date on the server; feed.js replaces it with "לפני 3 שעות" for recent articles (data-relative)
  const fullDate = (d) => new Date(d).toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
  const iso = (d) => new Date(d).toISOString();
%>
<h1 class="visually-hidden">The Daily Web - חדשות</h1>

<div class="layout">
  <main>
    <% if (front.featured) { %>
    <section id="front" class="front" aria-label="כתבות מובילות" <%= showFront ? '' : 'hidden' %>>
      <div class="front-main">
        <% if (front.medium.length) { %>
        <div class="front-side">
          <% front.medium.forEach((a) => { %>
          <article class="photo-card photo-card-sm" data-category="<%= a.category %>">
            <a href="/articles/<%= a.id %>">
              <% if (a.imageUrl) { %><img src="<%= a.imageUrl %>" alt="" width="600" height="400" loading="lazy"><% } %>
              <span class="cat-pill"><%= a.categoryLabel %></span>
              <h3 class="medium-title"><%= a.title %></h3>
              <span class="photo-arrow" aria-hidden="true">←</span>
            </a>
          </article>
          <% }) %>
        </div>
        <% } %>

        <!-- Hero carousel: every slide is in the HTML (readable without JS); carousel.js only switches the visible one -->
        <section class="carousel" aria-roledescription="carousel" aria-label="כתבה ראשית">
          <div class="carousel-slides">
            <% front.slides.forEach((a, i) => { %>
            <article class="photo-card carousel-slide <%= i === 0 ? 'is-active' : '' %>" data-category="<%= a.category %>" aria-roledescription="slide" aria-label="<%= i + 1 %> מתוך <%= front.slides.length %>">
              <a href="/articles/<%= a.id %>">
                <% if (a.imageUrl) { %><img src="<%= a.imageUrl %>" alt="" width="800" height="450" <%= i === 0 ? '' : 'loading="lazy"' %>><% } %>
                <span class="cat-pill"><%= a.categoryLabel %></span>
                <h3 class="featured-title"><%= a.title %></h3>
              </a>
              <p class="featured-summary"><%= a.summary %></p>
              <p class="item-meta"><%= a.author %> · <time datetime="<%= iso(a.publishedAt) %>" data-relative><%= fullDate(a.publishedAt) %></time></p>
            </article>
            <% }) %>
          </div>
          <% if (front.slides.length > 1) { %>
          <div class="carousel-controls" hidden>
            <button type="button" class="carousel-btn" data-carousel="prev" aria-label="הכתבה הקודמת">&lsaquo;</button>
            <button type="button" class="carousel-btn" data-carousel="next" aria-label="הכתבה הבאה">&rsaquo;</button>
          </div>
          <div class="carousel-dots" hidden></div>
          <% } %>
        </section>
      </div>

      <% if (front.strip.length) { %>
      <div class="front-strip">
        <% front.strip.forEach((a) => { %>
          <a href="/articles/<%= a.id %>" class="strip-item" data-category="<%= a.category %>">
            <% if (a.imageUrl) { %><img src="<%= a.imageUrl %>" alt="" width="96" height="72" loading="lazy"><% } %>
            <span class="strip-title"><%= a.title %></span>
          </a>
        <% }) %>
      </div>
      <% } %>
    </section>
    <% } %>

    <h2 class="section-title" id="feed-title">כל הכתבות</h2>
    <form id="feed-controls" class="feed-controls" role="search">
      <label for="category" class="visually-hidden">קטגוריה</label>
      <select id="category" name="category">
        <option value="">כל הקטגוריות</option>
        <% categories.forEach(cat => { %><option value="<%= cat %>" <%= initial.category === cat ? 'selected' : '' %>><%= categoryLabels[cat] %></option><% }) %>
      </select>
      <label for="viewed" class="visually-hidden">נצפה או לא נצפה</label>
      <select id="viewed" name="viewed">
        <option value="all">הכול</option>
        <option value="unviewed" <%= initial.viewed === 'unviewed' ? 'selected' : '' %>>לא נצפו</option>
        <option value="viewed" <%= initial.viewed === 'viewed' ? 'selected' : '' %>>נצפו</option>
      </select>
      <label for="sort" class="visually-hidden">מיון</label>
      <select id="sort" name="sort">
        <option value="date">חדש ביותר</option>
        <option value="popular" <%= initial.sort === 'popular' ? 'selected' : '' %>>פופולרי</option>
      </select>
    </form>

    <section id="feed" class="feed" aria-labelledby="feed-title"></section>
    <p id="feed-status" class="feed-status" role="status"></p>
    <div id="feed-sentinel"></div>

    <!-- One article card. feed.js clones it and fills the fields with textContent (never innerHTML - prevents XSS). -->
    <template id="card-template">
      <article class="card">
        <a class="card-link">
          <div class="card-media">
            <img class="card-image" alt="" loading="lazy" width="800" height="450">
            <span class="card-read-badge" hidden>✓ נקרא</span>
          </div>
          <div class="card-body">
            <span class="cat-label card-category"></span>
            <h3 class="card-title"></h3>
            <p class="card-summary"></p>
            <p class="item-meta"><span class="card-author"></span> · <time class="card-date"></time></p>
          </div>
        </a>
      </article>
    </template>
  </main>

  <!-- Sidebar starts at the top of the page: weather, then the most read articles, then the latest news -->
  <%# is-filtered: a search / category is active, so phones and tablets hide these boxes (see public.css) %>
  <aside class="sidebar sidebar-tall<%= showFront ? '' : ' is-filtered' %>">
    <%- include('../partials/weather') %>
    <%- include('../partials/sidebar-news', { mostRead: front.mostRead, latest: front.latest }) %>
  </aside>
</div>
<script src="/js/feed.js" defer></script>
<script src="/js/carousel.js" defer></script>
<%- include('../partials/footer') %>
