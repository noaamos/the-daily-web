<%- include('../partials/head', { styles: ['/css/public.css'] }) %>
<%- include('../partials/header', { navActive: article.category }) %>
<%
  const fullDate = (d) => new Date(d).toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
  const fullDateTime = (d) => new Date(d).toLocaleString('he-IL', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
%>
<div class="layout">
  <main>
    <!-- Owner: member 1. The full article is rendered here on the server (SEO). Comments load via Ajax. -->
    <article class="article-full" data-category="<%= article.category %>">
      <a href="/" class="back-link">→ חזרה לכל הכתבות</a>

      <header class="article-header">
        <span class="article-category"><%= categoryLabel %></span>
        <h1 class="article-title"><%= content.title %></h1>
        <% if (content.summary) { %><p class="article-summary"><%= content.summary %></p><% } %>
        <p class="article-meta">
          <span class="article-author"><%= authorName %></span>
          · <time datetime="<%= new Date(article.firstPublishedAt).toISOString() %>"><%= fullDate(article.firstPublishedAt) %></time>
          <% if (updatedAt) { %>
            · <span class="article-updated">עודכן: <time datetime="<%= new Date(updatedAt).toISOString() %>"><%= fullDateTime(updatedAt) %></time></span>
          <% } %>
        </p>
      </header>

      <% if (content.imageUrl) { %>
        <figure class="article-image">
          <img src="<%= content.imageUrl %>" alt="<%= content.title %>" width="800" height="450">
        </figure>
      <% } %>

      <div class="article-body">
        <% paragraphs.forEach((p) => { %><p><%= p %></p>
        <% }) %>
      </div>
    </article>

    <section id="comments" class="comments" data-article-id="<%= article._id %>" data-is-editor="<%= user && user.role === 'editor' ? '1' : '0' %>">
      <h2>תגובות</h2>
      <!-- Owner: member 2 - list loads with Ajax (comments.js), new comments are appended without reloading -->
      <ul id="comment-list" class="comment-list"></ul>
      <p id="comment-list-status" class="comment-status" role="status">טוען תגובות…</p>

      <form id="comment-form" class="comment-form" novalidate>
        <h3>הוספת תגובה</h3>
        <label for="comment-name">שם</label>
        <input id="comment-name" name="authorName" type="text" maxlength="50" required autocomplete="name" dir="auto">
        <label for="comment-text">תגובה</label>
        <textarea id="comment-text" name="text" rows="4" maxlength="1000" required dir="auto"></textarea>
        <div class="comment-form-footer">
          <button type="submit" class="btn-accent">פרסום תגובה</button>
          <p id="comment-form-status" class="comment-status" role="status"></p>
        </div>
      </form>
    </section>
  </main>
  <%- include('../partials/sidebar') %>
</div>
<script src="/js/comments.js" defer></script>
<%- include('../partials/footer') %>
