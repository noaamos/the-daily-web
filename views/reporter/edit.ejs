<%- include('../partials/head', { styles: ['/css/reporter.css'] }) %>
<%- include('../partials/header') %>
<main class="reporter-page edit-page" data-article-id="<%= article._id %>" data-status="<%= article.status %>" data-saved-at="<%= article.draftSavedAt ? article.draftSavedAt.toISOString() : '' %>">
  <p class="back-link"><a href="/reporter">חזרה לכתבות שלי</a></p>
  <div class="page-head">
    <h1 class="section-title">עריכת כתבה</h1>
    <span class="badge badge-<%= article.status %>"><%= statusLabel %></span>
  </div>

  <%# An article that has a published version is live: the public keeps seeing it while the reporter works on the draft. %>
  <% const live = Boolean(article.published); %>
  <% if (live) { %>
    <p class="notice info" role="status">
      <%= article.status === 'published' ? 'הכתבה פורסמה. השינויים שלך לא יופיעו באתר עד שהעורך יאשר אותם, והציבור ממשיך לראות את הגרסה המאושרת.'
        : article.status === 'pending' ? 'העדכון ממתין לאישור עורך, ולכן אי אפשר לערוך אותו כרגע. הציבור ממשיך לראות את הגרסה המאושרת.'
        : 'זה עדכון לכתבה שפורסמה. הציבור ממשיך לראות את הגרסה המאושרת עד שהעורך יאשר את העדכון.' %>
      <a href="/articles/<%= article._id %>" target="_blank" rel="noopener">צפייה בגרסה שפורסמה</a>
    </p>
  <% } else if (!canEdit) { %>
    <p class="notice" role="status">
      <%= article.status === 'pending' ? 'הכתבה ממתינה לאישור עורך, ולכן אי אפשר לערוך אותה כרגע.' : 'אי אפשר לערוך כתבה במצב הזה כרגע.' %>
    </p>
  <% } %>

  <% if (article.status === 'returned') { %>
    <%# The editor's note, filled on the server like the form, so a refresh (or another computer) shows it too. %>
    <section class="editor-note" aria-labelledby="editor-note-title">
      <h2 id="editor-note-title">הערת העורך</h2>
      <p><%= article.editorNote || 'העורך לא כתב הערה.' %></p>
    </section>
  <% } %>

  <%# A disabled fieldset locks every field inside it (read-only view). The textarea tags start with a line break
      on purpose: the browser drops the first one, so the text is shown exactly as it was saved. %>
  <form id="edit-form" class="edit-form" novalidate>
    <fieldset <%= canEdit ? '' : 'disabled' %>>
      <label for="f-category">קטגוריה</label>
      <%# The category belongs to the whole article (not to a version), so it stays fixed once the article is live. %>
      <select id="f-category" name="category"<%= live ? ' disabled' : '' %>>
        <% categories.forEach((cat) => { %><option value="<%= cat %>"<%= article.category === cat ? ' selected' : '' %>><%= categoryLabels[cat] %></option><% }) %>
      </select>
      <% if (live) { %><p class="field-hint">אי אפשר לשנות קטגוריה של כתבה שפורסמה.</p><% } %>

      <label for="f-title">כותרת</label>
      <input id="f-title" name="title" type="text" maxlength="200" value="<%= article.draft.title %>">

      <label for="f-summary">תקציר</label>
      <textarea id="f-summary" name="summary" rows="3" maxlength="500">
<%= article.draft.summary %></textarea>

      <label for="f-body">תוכן (שורה ריקה = פסקה חדשה)</label>
      <textarea id="f-body" name="body" rows="14" maxlength="50000">
<%= article.draft.body %></textarea>

      <label for="f-image">קישור לתמונה</label>
      <input id="f-image" name="imageUrl" type="url" maxlength="500" dir="ltr" value="<%= article.draft.imageUrl %>">
      <p class="field-hint is-error" id="image-hint" hidden>הקישור חייב להיות כתובת תקינה שמתחילה ב-<bdi dir="ltr">http://</bdi> או <bdi dir="ltr">https://</bdi> (או להישאר ריק). עד שיתוקן הוא לא יישמר ואי אפשר להגיש לאישור.</p>
      <%# Filled by image-preview.js: the picture itself, or a message when the link does not lead to a picture %>
      <div class="image-preview" id="image-preview" role="group" aria-labelledby="image-preview-title" hidden>
        <p class="preview-title" id="image-preview-title">תצוגה מקדימה</p>
        <img id="image-preview-img" alt="תצוגה מקדימה של התמונה הראשית" width="800" height="450" hidden>
        <p class="field-hint" id="image-preview-status" role="status" hidden></p>
      </div>
    </fieldset>

    <% if (canEdit) { %>
      <div class="form-actions">
        <button type="button" class="btn-accent" id="submit-btn"><%= article.status === 'returned' ? 'הגשה מחדש לאישור' : (article.status === 'published' ? 'הגשת העדכון לאישור' : 'הגשה לאישור') %></button>
        <button type="submit" class="btn-outline" id="save-btn">שמור עכשיו</button>
        <% if (article.status === 'published') { %><button type="button" class="btn-outline btn-danger" id="discard-btn">ביטול שינויים</button><% } %>
        <span id="save-status" class="save-status" role="status" aria-live="polite"></span>
        <span id="submit-block-reason" class="save-status error" role="status" hidden>אי אפשר להגיש: קישור התמונה לא תקין. תקנו אותו או השאירו ריק.</span>
      </div>
    <% } %>
  </form>
</main>
<script src="/js/image-link.js" defer></script>
<% if (canEdit) { %><script src="/js/reporter-edit.js" defer></script><% } %>
<script src="/js/image-preview.js" defer></script>
<%- include('../partials/footer') %>
