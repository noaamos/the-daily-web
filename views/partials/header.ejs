<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">The Daily Web<span class="logo-dot" aria-hidden="true"></span></a>
    <span class="header-date"><%= new Date().toLocaleDateString('he-IL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    <nav class="main-nav" aria-label="ניווט ראשי">
      <a href="/">ראשי</a>
      <% if (user && user.role === 'reporter') { %><a href="/reporter">הכתבות שלי</a><% } %>
      <% if (user && user.role === 'editor') { %><a href="/editor">ניהול</a><a href="/editor/analytics">סטטיסטיקות</a><% } %>
      <% if (user) { %>
        <form action="/auth/logout" method="post" class="inline-form"><button type="submit" class="nav-button">התנתקות (<%= user.displayName %>)</button></form>
      <% } else { %>
        <a href="/auth/login" class="nav-button">כניסת צוות</a>
      <% } %>
    </nav>
  </div>
</header>
