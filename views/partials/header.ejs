<%
  // navActive: '' = home, a category key = that category, undefined = nothing highlighted
  // hideCategoryNav: true on the login, reporter and editor pages (the category bar belongs to the public site)
  const active = typeof navActive !== 'undefined' ? navActive : null;
  const showCategoryNav = !(typeof hideCategoryNav !== 'undefined' && hideCategoryNav);
%>
<header class="site-header">
  <div class="masthead">
    <span class="masthead-date"><%= new Date().toLocaleDateString('he-IL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    <a href="/" class="logo">The Daily Web</a>
    <%# Home page only: the feed search. It sits in the header but belongs to #feed-controls (form attribute), so feed.js handles it like the filters - live, no reload %>
    <% if (typeof initial !== 'undefined') { %>
    <div class="masthead-search" role="search">
      <label for="q" class="visually-hidden">חיפוש כתבות</label>
      <input type="search" id="q" name="q" form="feed-controls" placeholder="חיפוש כתבות..." maxlength="100" value="<%= initial.q %>">
    </div>
    <% } %>
    <div class="masthead-actions">
      <% if (user && user.role === 'reporter') { %><a href="/reporter" class="masthead-link">הכתבות שלי</a><% } %>
      <% if (user && user.role === 'editor') { %>
        <a href="/editor" class="masthead-link">ניהול</a>
        <a href="/editor/analytics" class="masthead-link">סטטיסטיקות</a>
        <a href="/editor/users" class="masthead-link">משתמשים</a>
      <% } %>
      <% if (user) { %>
        <form action="/auth/logout" method="post" class="inline-form">
          <button type="submit" class="btn-outline">התנתקות (<%= user.displayName %>)</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="btn-accent">כניסת צוות</a>
      <% } %>
    </div>
  </div>

  <% if (showCategoryNav) { %>
  <nav class="category-nav" aria-label="קטגוריות">
    <div class="category-nav-inner">
      <a href="/" data-category="" class="<%= active === '' ? 'active' : '' %>">ראשי</a>
      <% categories.forEach((cat) => { %>
        <a href="/?category=<%= cat %>" data-category="<%= cat %>" class="<%= active === cat ? 'active' : '' %>"><%= categoryLabels[cat] %></a>
      <% }) %>
    </div>
  </nav>
  <% } %>
</header>
